# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.rs text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows batch scripts if any
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files (icons, images, fonts)
*.png binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
