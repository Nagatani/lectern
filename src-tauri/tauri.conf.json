{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lectern",
  "version": "0.3.0",
  "identifier": "app.lectern.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lectern — 講義資料作成・HTML/PDF変換ツール",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Lecture Markdown Editor & HTML/PDF Converter",
    "longDescription": "Lectern is a Rust & Tauri desktop application for authoring lecture materials in Markdown with live preview, custom CSS themes, KaTeX math, Mermaid diagrams, and exporting to standalone HTML and PDF.",
    "copyright": "Copyright © 2026 Lectern. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBNzE1MzA1Mzg2RTlFQkUKUldTK25tNDRCVk54T3FxRFU2VWVUNFR2Z1dva3RSNk5mQjhGZFBrWFVaNmFON2pQSFcrVit1aG0K",
      "endpoints": [
        "https://github.com/Nagatani/lectern/releases/latest/download/latest.json"
      ]
    }
  }
}
